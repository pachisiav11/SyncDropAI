{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncDrop",
  "version": "2.0.0",
  "identifier": "com.syncdrop.app",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SyncDrop",
        "width": 980,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../vendor/llama.cpp/": "vendor/llama.cpp/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
