# The rendezvous and relay address that installed apps connect to.
#
# Copy this file to .env and set the value before building the installer or the
# APK. Whatever is here is compiled into the bundle, so a person who installs
# SyncDrop never has to type an address: they open the app and pair.
#
# After `npm run worker:deploy`, use the workers.dev address Wrangler prints,
# or your own domain if you put one in front of it:
SYNCDROP_SERVER=https://syncdrop.example.workers.dev

# Self-hosting on your own machine instead? Run `npm run serve`, then use the
# address it prints for your network, for example:
# SYNCDROP_SERVER=http://192.168.1.20:8787
